# Monad mainnet. Chain id 143. Gas is MON, and cold storage is repriced — estimate before sending.
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz
NEXT_PUBLIC_MONAD_CHAIN_ID=143
NEXT_PUBLIC_MONAD_EXPLORER=https://monadvision.com
